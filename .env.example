# URL canónica del sitio publicado (sitemap, robots, OpenGraph y JSON-LD)
# Ej.: https://msoft1.com.es  (dominio propio)  o  https://usuario.github.io/nombre-repo
NEXT_PUBLIC_SITE_URL=

# Carpeta (subcarpeta) del sitio cuando se publica en GitHub Pages como project page.
# Deja este archivo vacío (o coméntalo) si se publica en la raíz de un dominio propio.
NEXT_PUBLIC_BASE_PATH=

# Supabase (público: solo anon key; la RLS restringe a solo inserción)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL de la Edge Function que envía el aviso por email con Resend
NEXT_PUBLIC_CONTACT_FUNCTION_URL=

# Variables de la Edge Function (se guardan como secrets de Supabase, NO aquí)
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
